# This file was generated using idf.py save-defconfig or menuconfig [D] key. It can be edited manually.
# Espressif IoT Development Framework (ESP-IDF) 5.5.2 Project Minimal Configuration
#
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_BT_ENABLED=y
CONFIG_BT_BTC_TASK_STACK_SIZE=2560
CONFIG_BT_BTU_TASK_STACK_SIZE=3072
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_A2DP_ENABLE=y
CONFIG_BT_AVRCP_CT_COVER_ART_ENABLED=n
CONFIG_BT_BLE_ENABLED=n
CONFIG_BT_ACL_CONNECTIONS=2
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=y
CONFIG_BTDM_CTRL_BR_EDR_MAX_ACL_CONN=2
CONFIG_BT_ALARM_MAX_NUM=20
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=n
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=2560
CONFIG_ESP_WIFI_NVS_ENABLED=n
CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=n
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_VTASKLIST_INCLUDE_COREID=y
CONFIG_LV_CONF_SKIP=n
CONFIG_LV_BUILD_EXAMPLES=n
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_API_ENCODING_UTF_8=y
CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
# 启动加速: 仅深睡唤醒跳过镜像校验(其他启动全量校验), 关闭PSRAM开机内存自检
CONFIG_BOOTLOADER_SKIP_VALIDATE_IN_DEEP_SLEEP=y
CONFIG_SPIRAM_MEMTEST=n
# 启动加速: 控制台波特率 115200→921600 (bootloader 与 app 共用同一位宽).
# 注意: ESP_CONSOLE_UART_BAUDRATE 的 Kconfig prompt 带 "if ESP_CONSOLE_UART_CUSTOM",
# 控制台选 "Default: UART0" 时该符号不可见, kconfiglib 会忽略用户值回落到 115200;
# 因此必须同时选 Custom UART(UART0+默认引脚, 行为与 Default 等价)才能让波特率生效.
CONFIG_ESP_CONSOLE_UART_CUSTOM=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=921600
# 省 IRAM: psram 缓存规避不再把 libc 时间函数放进 IRAM (5.5.5 后 .iram0.text 超限 512B)
CONFIG_SPIRAM_CACHE_LIBTIME_IN_IRAM=n
