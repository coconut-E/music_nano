# This file was generated using idf.py save-defconfig or menuconfig [D] key. It can be edited manually.
# Espressif IoT Development Framework (ESP-IDF) 5.5.2 Project Minimal Configuration
#
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_BT_ENABLED=y
CONFIG_BT_BTC_TASK_STACK_SIZE=2560
CONFIG_BT_BTU_TASK_STACK_SIZE=3072
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_A2DP_ENABLE=y
CONFIG_BT_AVRCP_CT_COVER_ART_ENABLED=n
CONFIG_BT_BLE_ENABLED=n
CONFIG_BT_ACL_CONNECTIONS=2
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=y
CONFIG_BTDM_CTRL_BR_EDR_MAX_ACL_CONN=2
CONFIG_BT_ALARM_MAX_NUM=20
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=n
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=2560
CONFIG_ESP_WIFI_NVS_ENABLED=n
CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=n
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_VTASKLIST_INCLUDE_COREID=y
CONFIG_LV_CONF_SKIP=n
CONFIG_LV_BUILD_EXAMPLES=n
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_API_ENCODING_UTF_8=y
CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
# 启动加速: 仅深睡唤醒跳过镜像校验(其他启动全量校验), 关闭PSRAM开机内存自检
CONFIG_BOOTLOADER_SKIP_VALIDATE_IN_DEEP_SLEEP=y
CONFIG_SPIRAM_MEMTEST=n
# 启动加速: 控制台波特率 115200→921600 (bootloader 与 app 共用同一位宽).
# 注意: ESP_CONSOLE_UART_BAUDRATE 的 Kconfig prompt 带 "if ESP_CONSOLE_UART_CUSTOM",
# 控制台选 "Default: UART0" 时该符号不可见, kconfiglib 会忽略用户值回落到 115200;
# 因此必须同时选 Custom UART(UART0+默认引脚, 行为与 Default 等价)才能让波特率生效.
CONFIG_ESP_CONSOLE_UART_CUSTOM=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=921600
# 省 IRAM: psram 缓存规避不再把 libc 时间函数放进 IRAM (5.5.5 后 .iram0.text 超限 512B)
CONFIG_SPIRAM_CACHE_LIBTIME_IN_IRAM=n
# OTA 回退: 新固件首次启动是 PENDING_VERIFY, 应用确认健康后才打标;
# 没打标就重启 → bootloader 判 ABORTED 并退回另一个槽 (见 main/app/ota.c)
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# ───────────────────────── 网络升级 (OTA over WiFi) 预备: 省 IRAM ─────────────────────────
# 前提: BT_ENABLED + SPIRAM + esp32 时 IRAM 只剩 2.5KB, 而 WiFi 驱动要 ~30KB.
# 下面两项 IDF 本来就对 "ESP32+蓝牙+PSRAM" 默认 n (esp_wifi/Kconfig 里
#   default n if (BT_ENABLED && SPIRAM && IDF_TARGET_ESP32)),
# 只是本工程的 sdkconfig 从更早版本继承成了 y. 关掉=恢复 IDF 默认, 只降 WiFi 吞吐.
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
# 只做 STA: 不开热点; 只连 WPA2 (或 WPA2/WPA3 混合), 不连 WPA3-only / OWE / 企业网.
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n
CONFIG_ESP_WIFI_ENABLE_WPA3_SAE=n
CONFIG_ESP_WIFI_ENABLE_SAE_PK=n
CONFIG_ESP_WIFI_ENABLE_SAE_H2E=n
CONFIG_ESP_WIFI_SOFTAP_SAE_SUPPORT=n
CONFIG_ESP_WIFI_ENABLE_WPA3_OWE_STA=n
# 再腾 ~8KB: 非 ISR 的 FreeRTOS 函数放 flash (IDF 官方给的手段, 只挪标了安全的那部分)
CONFIG_FREERTOS_PLACE_FUNCTIONS_INTO_FLASH=y
# 网络升级不做 TLS: 走明文 http + 镜像 SHA256 校验 (HTTPS 会拉进 mbedtls TLS 栈和
# 60KB 的 CA 证书包, app 分区放不下, 也用不上)
CONFIG_ESP_HTTP_CLIENT_ENABLE_HTTPS=n
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=n
# 只用 IPv4; IPv6 在 lwip 里占 26KB flash
CONFIG_LWIP_IPV6=n
# ── WiFi 运行期内部 RAM: 默认缓冲数太奢侈, 按默认值 esp_wifi_init 会直接
#    ESP_ERR_NO_MEM (实测 "Init static rx buffer: 1/10", 内部堆 47KB 也放不下).
#    本工程只用它扫一遍 AP + 连一次 + 下个 bin, 不需要 32 个动态收发缓冲.
#    IDF 默认 → 现在:
#      静态 RX 10 → 4 (每个 1.6KB, 扫描收 beacon 靠它, 不能再降)
#      动态 RX 4 → 2 (数据帧收发用; DHCP/ARP 一帧一帧来, 2 个够)
#      动态 TX 4 → 2 (每发一帧要一个, 串行发就够; 每个约 1.6KB DMA 内存)
#      管理帧短缓冲 32 → 6
#      管理 RX 5 → 2 (扫描结果靠它, 别再降)
#      AMPDU TX 关 (只影响上行聚合; 下载我们是收方, AMPDU RX 保留)
#    实测占用从 ~45KB 降到 ~20KB, 见 main/app/wifi_mgr.c 的 WiFi 已释放日志.
#
#    为什么要压到 2: 收/发缓冲都是从 "DMA 可用内部堆" 里拿的, 而这个池子本来就
#    只剩几 KB. 曾出现连 WiFi 时 DMA 只剩 719B、最大连续块 248B —— WiFi 每发
#    一帧要 ~1.6KB 的 TX 缓冲, 拿不到就返回 ESP_ERR_NO_MEM, 表现为
#    "关联成功、DISCOVER 发不出去、20 秒拿不到 IP"(见 wifi_mgr.c 的 TX 闸门).
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=2
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=2
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=6
CONFIG_ESP_WIFI_RX_MGMT_BUF_NUM_DEF=2
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
# 聚合窗口不能大于动态 RX 缓冲数 (Kconfig 里 wifi_init.c 有 #error 检查)
CONFIG_ESP_WIFI_RX_BA_WIN=2

# ── DHCP 的地址冲突检查: 全关 ────────────────────────────────────────────
# 这是 Kconfig 里的一个 choice (3 选 1), 所以不能写成 "ARP_CHECK=n" —— 那样
# 配置阶段会回落到默认项 (还是 ARP_CHECK), 等于没改. 必须显式选第三项.
#
# 为什么关: IDF 5.5.5 的 ARP 检查走 port/acd_dhcp_check.c, 收到 ACK 后先发 2 次
# ARP 探测 (间隔 500ms) 再 bind. 只要有人应答"这个 IP 我占了"(手机热点/带 ARP
# 代理的路由器就会替客户端应答), 它就发 DHCPDECLINE 并退避 10 秒, 然后重来 ——
# 而我们的连接窗口只有 20 秒, 于是表现为 "关联成功、DHCP 状态 STARTED、IP 一直
# 0.0.0.0、20 秒超时". 换哪家 WiFi 都可能中招, 且和信号强度无关.
# 参考 espressif/esp-idf#17500 (IDFGH-16360): decline 之后客户端不再重试.
#
# 关掉以后: 收到 ACK 直接 dhcp_bind(), 不探测、不 DECLINE, 1 秒内拿到 IP.
# 代价: 万一同网段真有别的设备抢同一个地址, 不会自动避让 (家用/手机热点场景里
# 这个概率远低于上面那个坑).
#
# 注意: 本文件只是"新配置的种子". idf.py 只读 sdkconfig, 已经存在的 sdkconfig
# 不会被这里的值覆盖 —— 所以同样的三行在 sdkconfig 里也必须改, 两边要一致.
# 编译完 tools/check_sdkconfig.ps1 会核对实际生效值 (build.ps1 已自动调用).
# CONFIG_LWIP_DHCP_DOES_ARP_CHECK is not set
# CONFIG_LWIP_DHCP_DOES_ACD_CHECK is not set
CONFIG_LWIP_DHCP_DOES_NOT_CHECK_OFFERED_IP=y
